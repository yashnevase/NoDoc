{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrivatePDF",
  "version": "0.1.0",
  "identifier": "com.privatepdf.suite",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "beforeBuildCommand": "npm run build --prefix ../frontend",
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "PrivatePDF",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": ["sidecar/privatepdf-sidecar.exe"],
    "externalBin": []
  }
}
