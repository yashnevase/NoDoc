{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoDoc",
  "version": "0.1.0",
  "identifier": "com.yashnevase.nodoc",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "title": "NoDoc",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "name": "PDF Document",
        "description": "Open PDF files with NoDoc",
        "role": "Viewer",
        "rank": "Default"
      },
      {
        "ext": ["png"],
        "mimeType": "image/png",
        "name": "PNG Image",
        "description": "Open PNG files with NoDoc",
        "role": "Viewer",
        "rank": "Default"
      },
      {
        "ext": ["jpg", "jpeg"],
        "mimeType": "image/jpeg",
        "name": "JPEG Image",
        "description": "Open JPEG files with NoDoc",
        "role": "Viewer",
        "rank": "Default"
      },
      {
        "ext": ["webp"],
        "mimeType": "image/webp",
        "name": "WebP Image",
        "description": "Open WebP files with NoDoc",
        "role": "Viewer",
        "rank": "Default"
      },
      {
        "ext": ["bmp"],
        "mimeType": "image/bmp",
        "name": "Bitmap Image",
        "description": "Open BMP files with NoDoc",
        "role": "Viewer",
        "rank": "Default"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "NoDoc"
      },
      "wix": {
        "upgradeCode": "9a01d6b6-2d31-5a69-a7c4-0c314cb2e0ab"
      }
    },
    "resources": ["sidecar", "ocr"],
    "externalBin": []
  }
}
